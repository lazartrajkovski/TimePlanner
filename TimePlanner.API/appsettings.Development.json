  {
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      },
      "Console": {
        "FormatterName": "simple",
        "FormatterOptions": {
          "SingleLine": true,
          "IncludeScopes": false,
          "UseUtcTimestamp": true,
          "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ "
        }
      }
    }
  }
